# Server
PORT=3000
NODE_ENV=development

# Database (Supabase PostgreSQL)
# Pooler connection string (Transaction mode, port 6543)
DATABASE_URL=
# Direct connection string (Session mode or direct, port 5432)
DIRECT_URL=

# Supabase Project
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase JWT Verification ('jwks' or 'hs256')
JWT_VERIFY_MODE=jwks
SUPABASE_JWKS_URL=
SUPABASE_JWT_SECRET=
